<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ i18n.en.meta.title }}</title>
    <meta name="title" content="{{ i18n.en.meta.title }}">
    <meta name="description" content="{{ i18n.en.meta.description }}">
    <meta name="theme-color" content="#f3f7f6" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0f1a1d" media="(prefers-color-scheme: dark)">
    <link rel="canonical" href="{{ url |> url(true) }}">
    {{# Social previews: crawlers don't run JS, so these stay in English.
       og:image needs an absolute URL; og-image.png is rendered from
       og-image.svg #}}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ i18n.en.meta.title }}">
    <meta property="og:url" content="{{ url |> url(true) }}">
    <meta property="og:title" content="{{ i18n.en.meta.shareTitle }}">
    <meta property="og:description" content="{{ i18n.en.meta.description }}">
    <meta property="og:locale" content="en_US">
    <meta property="og:locale:alternate" content="it_IT">
    <meta property="og:image" content="{{ '/og-image.png' |> url(true) }}">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ i18n.en.meta.imageAlt }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ i18n.en.meta.shareTitle }}">
    <meta name="twitter:description" content="{{ i18n.en.meta.description }}">
    <meta name="twitter:image:alt" content="{{ i18n.en.meta.imageAlt }}">
    <meta name="twitter:image" content="{{ '/og-image.png' |> url(true) }}">
    <link rel="icon" href="{{ '/favicon.ico' |> url }}" sizes="16x16 32x32 48x48">
    <link rel="icon" type="image/svg+xml" href="{{ '/favicon.svg' |> url }}">
    <link rel="apple-touch-icon" href="{{ '/icons/apple-touch-icon.png' |> url }}">
    <link rel="manifest" href="{{ '/manifest.webmanifest' |> url }}">
    <meta name="apple-mobile-web-app-title" content="Subs tracker">
    <link rel="preconnect" href="https://fonts.bunny.net">
    <link rel="stylesheet" href="https://fonts.bunny.net/css?family=nunito:400,600,700,800&display=swap">
    <link rel="stylesheet" href="{{ '/styles.css' |> url }}">
    <script>
      // Apply the saved theme and language before first paint (main.js is
      // deferred). The markup is in English: for any other language keep the
      // page hidden until main.js has translated it (see detectLocale in
      // js/lib/i18n.ts for the same browser language lookup).
      try {
        const root = document.documentElement;
        const saved = JSON.parse(localStorage.getItem("subs-tracker"));
        const locales = {{ JSON.stringify(Object.keys(i18n)) }};
        const locale = locales.includes(saved?.language)
          ? saved.language
          : navigator.languages
            .map((language) => language.toLowerCase().split("-")[0])
            .find((language) => locales.includes(language));
        if (saved?.theme) root.dataset.theme = saved.theme;
        if (locales.includes(locale) && locale !== "en") {
          root.lang = locale;
          root.dataset.i18nPending = "";
        }
      } catch {}
    </script>
    <script type="module" src="{{ '/js/main.js' |> url }}"></script>
  </head>
  <body x-data>
    <a class="skip-link" href="#content" x-text="$t.header.skip">{{ i18n.en.header.skip }}</a>
    {{ include "partials/header.vto" }}
    <main id="content" class="container">
      {{ content }}
    </main>
    {{ include "partials/footer.vto" }}
    {{ include "partials/install.vto" }}
  </body>
</html>

{{# Decorative empty-state scene: fanned subscription cards, bobbing coins and
   twinkling sparkles. Colours come from --illo-* tokens and the motion from
   the .illo rules in styles.css. #}}
<svg class="illo" viewBox="0 0 260 200" aria-hidden="true" focusable="false">
  <ellipse class="illo__blob" cx="130" cy="100" rx="104" ry="86" />
  <ellipse class="illo__shadow" cx="132" cy="178" rx="64" ry="7" />

  <g class="illo__stack">
    <rect class="illo__card illo__card--back" x="74" y="66" width="120" height="78" rx="14" />
    <rect class="illo__card illo__card--mid" x="72" y="70" width="122" height="80" rx="14" />
    <g class="illo__card illo__card--front">
      <rect class="illo__card-bg" x="70" y="74" width="124" height="80" rx="14" />
      <circle class="illo__avatar" cx="95" cy="99" r="11" />
      <rect class="illo__line" x="113" y="92" width="58" height="7" rx="3.5" />
      <rect class="illo__line illo__line--faint" x="113" y="104" width="36" height="6" rx="3" />
      <rect class="illo__pill" x="84" y="128" width="42" height="14" rx="7" />
      <rect class="illo__price" x="146" y="128" width="34" height="14" rx="7" />
    </g>
  </g>

  <g class="illo__coin illo__coin--big">
    <circle cx="208" cy="56" r="18" />
    <text x="208" y="62.5" text-anchor="middle">€</text>
  </g>
  <g class="illo__coin illo__coin--small">
    <circle cx="52" cy="70" r="11" />
    <text x="52" y="74.5" text-anchor="middle">$</text>
  </g>

  <g transform="translate(46 132)"><path class="illo__sparkle" d="M0-9C1-3 3-1 9 0C3 1 1 3 0 9C-1 3-3 1-9 0C-3-1-1-3 0-9Z" /></g>
  <g transform="translate(222 118)"><path class="illo__sparkle illo__sparkle--2" d="M0-7C1-2 2-1 7 0C2 1 1 2 0 7C-1 2-2 1-7 0C-2-1-1-2 0-7Z" /></g>
  <g transform="translate(156 30)"><path class="illo__sparkle illo__sparkle--3" d="M0-6C1-2 2-1 6 0C2 1 1 2 0 6C-1 2-2 1-6 0C-2-1-1-2 0-6Z" /></g>
</svg>

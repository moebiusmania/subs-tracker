{{# Export and import: a dialog to pick a JSON file or a QR code, opened
   with transfer-export and transfer-import events. main.ts sends
   transfer-receive when a share link (#d=…) opens the app: then it asks
   before importing. The transfer component is in js/lib/components.ts #}}
<div
  x-data="transfer"
  @transfer-export.window="openExport()"
  @transfer-import.window="openImport()"
  @transfer-receive.window="receive($event.detail)"
  x-effect="mode ? $refs.dialog.open || $refs.dialog.showModal() : $refs.dialog.close()"
>
  <dialog
    class="transfer"
    x-ref="dialog"
    aria-labelledby="transfer-title"
    @close="close()"
    @pointerdown="pressed = $event.target === $el"
    @click.self="pressed && close()"
  >
    <div class="transfer__panel">
      <header class="transfer__header">
        <h2 id="transfer-title" x-text="title">{{ i18n.en.backup.export }}</h2>
        <button
          type="button"
          class="icon-btn"
          aria-label="{{ i18n.en.transfer.close }}"
          :aria-label="$t.transfer.close"
          :title="$t.transfer.close"
          @click="close()"
        >
          {{ include "partials/icon.vto" { name: "x" } }}
        </button>
      </header>

      {{# Export or import: a file or a QR code #}}
      <template x-if="(mode === 'export' || mode === 'import') && view === 'choose'">
        <div class="transfer__body">
          <p class="transfer__intro" x-text="mode === 'export' ? $t.transfer.exportIntro : $t.transfer.importIntro"></p>
          <div class="transfer__choices">
            <button type="button" class="choice" @click="mode === 'export' ? saveFile() : openFile()">
              <span class="choice__icon">{{ include "partials/icon.vto" { name: "file" } }}</span>
              <span class="choice__title" x-text="$t.transfer.file"></span>
              <span class="choice__text" x-text="mode === 'export' ? $t.transfer.fileExport : $t.transfer.fileImport"></span>
            </button>

            <template x-if="mode === 'export'">
              <button type="button" class="choice" :disabled="busy" @click="showQr()">
                <span class="choice__icon">{{ include "partials/icon.vto" { name: "qr-code" } }}</span>
                <span class="choice__title" x-text="$t.transfer.qr"></span>
                <span class="choice__text" x-text="busy ? $t.transfer.loading : $t.transfer.qrExport"></span>
              </button>
            </template>

            {{# Scanning happens in the camera app: the link opens this page.
               Pasting it covers links sent by message and installed apps,
               which don't share storage with the browser on every system #}}
            <template x-if="mode === 'import'">
              <div class="choice choice--static">
                <span class="choice__icon">{{ include "partials/icon.vto" { name: "qr-code" } }}</span>
                <span class="choice__title" x-text="$t.transfer.qr"></span>
                <span class="choice__text" x-text="$t.transfer.scanHow"></span>
                <form class="transfer__paste" @submit.prevent="importPasted()">
                  <label for="transfer-link" x-text="$t.transfer.link"></label>
                  <div class="transfer__paste-row">
                    <input
                      type="url"
                      id="transfer-link"
                      placeholder="https://…#d=…"
                      autocomplete="off"
                      spellcheck="false"
                      x-model="pasted"
                      required
                    >
                    <button type="submit" class="btn btn--sm" x-text="$t.transfer.importLink"></button>
                  </div>
                </form>
              </div>
            </template>
          </div>
          <p class="transfer__note" x-show="mode === 'import'" x-text="$t.transfer.replaces"></p>
          <p class="transfer__error" role="alert" x-show="error" x-text="error"></p>
        </div>
      </template>

      {{# The QR code: dark on white whatever the theme, for the scanners #}}
      <template x-if="view === 'qr'">
        <div class="transfer__body">
          <div class="transfer__qr" role="img" :aria-label="$t.transfer.qrAlt" x-html="qr"></div>
          <p class="transfer__intro" x-text="$t.transfer.qrHint"></p>
          <div class="transfer__actions">
            <button type="button" class="btn btn--ghost btn--sm" @click="back()">
              {{ include "partials/icon.vto" { name: "arrow-left" } }} <span x-text="$t.transfer.back"></span>
            </button>
            <button type="button" class="btn btn--sm" @click="copyLink()">
              {{ include "partials/icon.vto" { name: "copy" } }} <span aria-live="polite" x-text="copied ? $t.transfer.copied : $t.transfer.copy"></span>
            </button>
          </div>
        </div>
      </template>

      {{# A share link opened the app #}}
      <template x-if="mode === 'link'">
        <div class="transfer__body">
          <p class="transfer__intro" x-show="busy" x-text="$t.transfer.loading"></p>
          <p class="transfer__intro" x-show="pending.length" x-text="confirmText"></p>
          <p class="transfer__error" role="alert" x-show="error" x-text="error"></p>
          <div class="transfer__actions">
            <button type="button" class="btn btn--ghost btn--sm" @click="close()" x-text="$t.transfer.cancel"></button>
            <button
              type="button"
              class="btn btn--primary btn--sm"
              x-show="pending.length"
              @click="acceptLink()"
            >
              {{ include "partials/icon.vto" { name: "upload" } }} <span x-text="$t.transfer.accept"></span>
            </button>
          </div>
        </div>
      </template>
    </div>
  </dialog>
</div>

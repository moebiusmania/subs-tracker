{{# The home page. /add/ and /edit/ render it too: main.ts opens the form
   dialog over it from the URL, so those links still work on their own #}}
<div x-data>
  <template x-if="$store.app.data.length === 0">
    <section class="empty panel" x-data="empty">
      {{ include "partials/app-bar.vto" { extra: "empty__bar" } }}
      <div class="empty__body">
        <h1 x-text="$t.empty.title">{{ i18n.en.empty.title }}</h1>
        <p x-text="$t.empty.message">{{ i18n.en.empty.message }}</p>
        <div class="empty__actions">
          <a class="btn btn--primary" href="{{ '/add/' |> url }}">
            {{ include "partials/icon.vto" { name: "plus" } }} <span x-text="$t.empty.cta">{{ i18n.en.empty.cta }}</span>
          </a>
          <span class="empty__or" x-text="$t.empty.or">{{ i18n.en.empty.or }}</span>
          <button type="button" class="btn" @click="useMock">
            {{ include "partials/icon.vto" { name: "list" } }} <span x-text="$t.empty.default">{{ i18n.en.empty.default }}</span>
          </button>
        </div>
        {{# Opens partials/tour.vto; getting near it starts fetching the
           animation #}}
        <button
          type="button"
          class="tour-link"
          @click="$dispatch('tour-open')"
          @pointerenter.once="$dispatch('tour-prefetch')"
          @focus.once="$dispatch('tour-prefetch')"
        >
          {{ include "partials/icon.vto" { name: "play" } }} <span x-text="$t.tour.link">{{ i18n.en.tour.link }}</span>
        </button>
      </div>
    </section>
  </template>

  <template x-if="$store.app.data.length > 0">
    <div class="stack">
      <section class="stats" x-data="dashboard" aria-labelledby="stats-title">
        <h1 id="stats-title" class="section-title" x-text="$t.main.title">{{ i18n.en.main.title }}</h1>
        <div class="stats__grid panel">
          {{ include "partials/stat.vto" { label: "total", value: "total", description: "inactives", tint: "lav", icon: "list" } }}
          {{ include "partials/stat.vto" { label: "monthly", value: "monthly", description: "$t.main.detail", tint: "mint", icon: "calendar" } }}
          {{ include "partials/stat.vto" { label: "yearly", value: "yearly", description: "$t.main.detail", tint: "peach", icon: "calendar-range" } }}
        </div>
      </section>

      <section class="subs" x-data="list" aria-labelledby="subs-title">
        <header class="subs__header">
          <h2 id="subs-title" class="section-title subs__title">
            <span x-text="$t.main.list">{{ i18n.en.main.list }}</span>
            <span class="subs__count" x-text="$store.app.data.length"></span>
          </h2>
          <a class="btn btn--primary btn--sm" href="{{ '/add/' |> url }}">
            {{ include "partials/icon.vto" { name: "plus" } }} <span x-text="$t.main.cta">{{ i18n.en.main.cta }}</span>
          </a>
        </header>

        <ul class="subs__grid" role="list">
          <template x-for="(item, index) in $store.app.data" :key="index">
            <li
              class="sub-card"
              :class="{
                'is-inactive': !item.isActive,
                'is-due': expiresThisMonth(item),
              }"
            >
              <div class="sub-card__top">
                <span
                  class="sub-card__avatar"
                  aria-hidden="true"
                  x-text="item.name.trim().charAt(0).toUpperCase() || '?'"
                ></span>
                <div class="sub-card__name">
                  <h3 x-text="item.name"></h3>
                  <span class="sub-card__recurrence" x-text="recurrence(item)"></span>
                </div>
                <div class="sub-card__tools">
                  <a
                    class="icon-btn"
                    :href="'{{ '/edit/' |> url }}?item=' + index"
                    :aria-label="editLabel(item)"
                    :title="editLabel(item)"
                  >
                    {{ include "partials/icon.vto" { name: "pencil" } }}
                  </a>
                  <button
                    type="button"
                    class="icon-btn icon-btn--danger"
                    :aria-label="deleteLabel(item)"
                    :title="deleteLabel(item)"
                    @click="deleteItem(index)"
                  >
                    {{ include "partials/icon.vto" { name: "trash" } }}
                  </button>
                </div>
              </div>
              <p class="sub-card__price" x-text="item.price + item.currency"></p>
              <div class="sub-card__bottom">
                <p class="sub-card__expires">
                  {{ include "partials/icon.vto" { name: "calendar" } }}
                  <span class="visually-hidden" x-text="$t.main.expires">{{ i18n.en.main.expires }}</span>
                  <time
                    :datetime="new Date(item.expiration).toISOString()"
                    x-text="expiration(item)"
                  ></time>
                  <span
                    class="sub-card__due"
                    x-show="expiresThisMonth(item)"
                    x-text="$t.main.thisMonth"
                  >{{ i18n.en.main.thisMonth }}</span>
                </p>
                <button
                  type="button"
                  class="status"
                  :aria-label="statusLabel(item)"
                  @click="toggleActive(index)"
                >
                  <span class="status__dot" aria-hidden="true"></span>
                  <span x-text="status(item)"></span>
                </button>
              </div>
            </li>
          </template>
        </ul>

        <footer class="subs__actions">
          <div class="subs__backup" x-data="backup">
            <button type="button" class="btn btn--sm" @click="exportData">
              {{ include "partials/icon.vto" { name: "download" } }} <span x-text="$t.backup.export">{{ i18n.en.backup.export }}</span>
            </button>
            <button type="button" class="btn btn--sm" @click="importData">
              {{ include "partials/icon.vto" { name: "upload" } }} <span x-text="$t.backup.import">{{ i18n.en.backup.import }}</span>
            </button>
          </div>
          <button type="button" class="btn btn--sm btn--danger" @click="deleteAll">
            {{ include "partials/icon.vto" { name: "trash" } }} <span x-text="$t.main.delete">{{ i18n.en.main.delete }}</span>
          </button>
        </footer>
      </section>
    </div>
  </template>
</div>

{{ include "partials/form-dialog.vto" }}
{{ include "partials/tour.vto" }}

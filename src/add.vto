<section class="panel add">
  <a class="back-link" href="{{ '/' |> url }}">
    {{ include "partials/icon.vto" { name: "arrow-left" } }} Go back to the main screen
  </a>
  <h1>Add a new subscription</h1>
  <p class="add__intro">
    The subscription data will be <strong>stored locally</strong>. It will
    not be available on other device and there are no security or privacy
    concerns.
  </p>

  <form class="form" x-data="addForm('{{ '/' |> url }}')" @submit.prevent="submit">
    <div class="field field--full">
      <label for="name">Service name</label>
      <input type="text" id="name" name="name" placeholder="ex: Netflix, Prime, etc.." x-model="item.name" required autofocus>
    </div>

    <div class="field">
      <label for="price">How much does it costs?</label>
      <input
        type="number"
        id="price"
        name="price"
        inputmode="decimal"
        placeholder="10.00"
        min="0.1"
        step="0.1"
        :value="item.price.toString()"
        @input="item.price = parseFloat($event.target.value)"
        required
      >
    </div>

    <div class="field">
      <label for="currency">Currency</label>
      <select id="currency" name="currency" x-model="item.currency" required disabled>
        <option value="€">€ Euro</option>
        <option value="$">$ Dollar</option>
      </select>
    </div>

    <div class="field">
      <label for="expiration">Date of expiration</label>
      <input
        type="date"
        id="expiration"
        name="expiration"
        :value="formatDate(item.expiration)"
        @input="item.expiration = new Date($event.target.value)"
        required
      >
    </div>

    <div class="field">
      <label for="recurrence">Recurs</label>
      <select id="recurrence" name="recurrence" x-model="item.recurrence" required>
        <option value="monthly">Monthly</option>
        <option value="yearly">Yearly</option>
      </select>
    </div>

    <div class="field field--full field--switch">
      <input type="checkbox" class="switch" id="isactive" name="isactive" role="switch" x-model="item.isActive">
      <label for="isactive">Is active?</label>
    </div>

    <div class="form__actions">
      <button type="submit" class="btn btn--primary">
        {{ include "partials/icon.vto" { name: "plus" } }} Add this subscription
      </button>
      <a class="btn btn--ghost" href="{{ '/' |> url }}">Cancel</a>
    </div>
  </form>
</section>

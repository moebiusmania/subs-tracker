<div x-data>
  <template x-if="$store.app.data.length === 0">
    <section class="empty panel" x-data="empty">
      <span class="empty__icon">{{ include "partials/icon.vto" { name: "inbox" } }}</span>
      <h1>{{ i18n.empty.title }}</h1>
      <p>{{ i18n.empty.message }}</p>
      <div class="empty__actions">
        <a class="btn btn--primary" href="{{ '/add/' |> url }}">
          {{ include "partials/icon.vto" { name: "plus" } }} {{ i18n.empty.cta }}
        </a>
        <span class="empty__or">{{ i18n.empty.or }}</span>
        <button type="button" class="btn" @click="useMock">
          {{ include "partials/icon.vto" { name: "sparkles" } }} {{ i18n.empty.default }}
        </button>
      </div>
    </section>
  </template>

  <template x-if="$store.app.data.length > 0">
    <div class="stack">
      <section class="stats" x-data="dashboard" aria-labelledby="stats-title">
        <h1 id="stats-title" class="section-title">{{ i18n.main.title }}</h1>
        <div class="stats__grid">
          {{ include "partials/stat.vto" { title: i18n.main.total, value: "total", description: "inactives" } }}
          {{ include "partials/stat.vto" { title: i18n.main.monthly, value: "monthly", description: "$store.app.i18n.main.detail", accent: true } }}
          {{ include "partials/stat.vto" { title: i18n.main.yearly, value: "yearly", description: "$store.app.i18n.main.detail" } }}
        </div>
      </section>

      <section class="subs" x-data="list" aria-labelledby="subs-title">
        <header class="subs__header">
          <h2 id="subs-title" class="section-title">{{ i18n.main.list }}</h2>
          <a class="btn btn--primary" href="{{ '/add/' |> url }}">
            {{ include "partials/icon.vto" { name: "plus" } }} {{ i18n.main.cta }}
          </a>
        </header>

        <ul class="subs__grid" role="list">
          <template x-for="(item, index) in $store.app.data" :key="index">
            <li class="sub-card" :class="{ 'is-inactive': !item.isActive }">
              <div class="sub-card__top">
                <h3 class="sub-card__name" x-text="item.name"></h3>
                <button
                  type="button"
                  class="status"
                  :aria-label="(item.isActive ? 'Active' : 'Inactive') + ', toggle ' + item.name"
                  @click="toggleActive(index)"
                >
                  <span class="status__dot" aria-hidden="true"></span>
                  <span x-text="item.isActive ? 'Active' : 'Inactive'"></span>
                </button>
              </div>
              <p class="sub-card__price">
                <span x-text="item.price + item.currency"></span>
                <span class="sub-card__recurrence" x-text="item.recurrence"></span>
              </p>
              <p class="sub-card__expires">
                {{ include "partials/icon.vto" { name: "calendar" } }}
                {{ i18n.main.expires }}
                <time
                  :datetime="new Date(item.expiration).toISOString()"
                  x-text="new Date(item.expiration).toLocaleDateString()"
                ></time>
              </p>
            </li>
          </template>
        </ul>

        <footer class="subs__actions">
          <div class="subs__backup" x-data="backup">
            <button type="button" class="btn" @click="exportData">
              {{ include "partials/icon.vto" { name: "download" } }} {{ i18n.backup.export }}
            </button>
            <button type="button" class="btn" @click="importData">
              {{ include "partials/icon.vto" { name: "upload" } }} {{ i18n.backup.import }}
            </button>
          </div>
          <button type="button" class="btn btn--danger" @click="deleteAll">
            {{ include "partials/icon.vto" { name: "trash" } }} {{ i18n.main.delete }}
          </button>
        </footer>
      </section>
    </div>
  </template>
</div>
